<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Allow the server to follow symlinks
    Options +FollowSymLinks

    # Basic rewrite rule to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Ensure basic access is allowed
<Directory "public_html/MCC-IPES">
    Require all granted
    Allow from all
    Order allow,deny
    Allow from all
</Directory>

# Basic protection for sensitive files
<Files ~ "^\.env|composer.json|package.json">
    Order allow,deny
    Deny from all
</Files>

# Set default charset
AddDefaultCharset UTF-8
</IfModule>


AddDefaultCharset UTF-8